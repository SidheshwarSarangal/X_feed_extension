{
  "manifest_version": 3,
  "name": "X Feed Extension",
  "version": "1.0",
  "action": {
    "default_popup": "main.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"]
}
