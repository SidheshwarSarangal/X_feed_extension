{
  "manifest_version": 3,
  "name": "X Feed Viewer",
  "version": "1.0",
  "description": "View your friend's X home feed.",
  "action": {
    "default_popup": "main.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "permissions": [],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
